# Telegram Bot Token — get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Channel username (without @) — for PUBLIC channels
# Multiple channels: separate with commas
# Example: my_channel1,my_channel2
# Leave empty if all channels are private
CHANNEL_USERNAME=

# Channel ID — for PRIVATE channels
# Multiple channels: separate with commas
# Example: -1001234567890,-1009876543210
CHANNEL_ID=

# Telegram API credentials — from https://my.telegram.org → API Development Tools
API_ID=0
API_HASH=

# User session string — from running generate_session.py locally
# This allows the bot to read channel history (bots can't do this directly)
SESSION_STRING=

# Gemini AI API key — from https://aistudio.google.com (free)
# Enables smart app name extraction from messy sentences and spelling mistakes
GEMINI_API_KEY=

# Database file path (default: bot_data.db)
DB_PATH=bot_data.db
