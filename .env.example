# Telegram Bot Token — get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Channel username (without @) — only if the channel is PUBLIC
# Example: my_channel (for t.me/my_channel)
# Leave empty if the channel is private
CHANNEL_USERNAME=

# Channel ID — needed if the channel is private
# Get this by forwarding a message from your channel to @userinfobot
# Example: -1001234567890
CHANNEL_ID=

# Database file path (default: bot_data.db)
DB_PATH=bot_data.db
